#!/usr/bin/env bash
set -euo pipefail
exec > >(tee -a /var/log/scaler-cloud-bootstrap.log) 2>&1
trap 'echo "BOOTSTRAP_FAILED line $LINENO"' ERR
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
install -d -m 0755 /opt/scaler-cloud /etc/rancher/k3s
cd /opt/scaler-cloud
dnf install -y tar gzip openssl iptables-nft
systemctl enable --now amazon-ssm-agent
# AL2023 defaults to permissive SELinux. Do not silently weaken an enforcing host.
# This lab skips the installer's EL8 policy RPM; enforcing hosts need policy setup.
if command -v getenforce >/dev/null && [ "$(getenforce)" = Enforcing ]; then
  echo 'AL2023 enforcing SELinux requires a compatible K3s SELinux policy.'
  exit 1
fi

# The VPC is 10.42.0.0/16; K3s must use distinct Pod and Service ranges.
# Traefik owns port 80. The Session 19 host-level Nginx service is not installed.
cat > /etc/rancher/k3s/config.yaml <<'K3S'
cluster-cidr: 10.52.0.0/16
service-cidr: 10.53.0.0/16
cluster-dns: 10.53.0.10
write-kubeconfig-mode: "0600"
K3S
curl --fail --location --retry 5 --output install-k3s.sh 'https://raw.githubusercontent.com/k3s-io/k3s/${k3s_version}/install.sh'
INSTALL_K3S_SKIP_SELINUX_RPM=true INSTALL_K3S_VERSION='${k3s_version}' sh install-k3s.sh server
# The API can start before the local kubelet creates its Node object.
wait_for_node_registration() {
  local attempt
  for attempt in {1..60}; do
    if [ -n "$(kubectl get nodes -o name 2>/dev/null)" ]; then
      return 0
    fi
    sleep 5
  done
  echo 'Node registration timed out after 300 seconds.' >&2
  return 1
}
wait_for_node_registration
kubectl wait --for=condition=Ready node --all --timeout=300s

curl --fail --location --retry 5 --output helm.tar.gz 'https://get.helm.sh/helm-v${helm_version}-linux-amd64.tar.gz'
curl --fail --location --retry 5 --output helm.sha256 'https://get.helm.sh/helm-v${helm_version}-linux-amd64.tar.gz.sha256sum'
sed 's/helm-v${helm_version}-linux-amd64.tar.gz/helm.tar.gz/' helm.sha256 | sha256sum --check -
tar -xzf helm.tar.gz
install -m 0755 linux-amd64/helm /usr/local/bin/helm

curl --fail --location --retry 5 --output flux.tar.gz 'https://github.com/fluxcd/flux2/releases/download/v${flux_version}/flux_${flux_version}_linux_amd64.tar.gz'
curl --fail --location --retry 5 --output flux-checksums.txt 'https://github.com/fluxcd/flux2/releases/download/v${flux_version}/flux_${flux_version}_checksums.txt'
grep ' flux_${flux_version}_linux_amd64.tar.gz$' flux-checksums.txt | sed 's/flux_${flux_version}_linux_amd64.tar.gz/flux.tar.gz/' | sha256sum --check -
tar -xzf flux.tar.gz flux
install -m 0755 flux /usr/local/bin/flux
flux install --version=v${flux_version} --components=source-controller,kustomize-controller,helm-controller --timeout=5m

kubectl create namespace cloud-final --dry-run=client -o yaml | kubectl apply -f -
# Generate only at runtime. No secret values are in Terraform state or Git.
if ! kubectl -n cloud-final get secret app-secret >/dev/null 2>&1; then
  umask 077
  openssl rand -hex 32 > /opt/scaler-cloud/runtime-token
  kubectl -n cloud-final create secret generic app-secret --from-file=token=/opt/scaler-cloud/runtime-token
  rm -f /opt/scaler-cloud/runtime-token
  umask 022
fi

# Flux is the only owner of this Helm release. The source commit already exists.
# The existing chart's image field is transformed to the scanned digest by Flux.
cat > /opt/scaler-cloud/application.yaml <<'APPLICATION'
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: cloud-source
  namespace: flux-system
spec:
  interval: 1m
  url: https://github.com/ReaperXD67/devops-homework.git
  ref:
    commit: ${source_revision}
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: cloud-app
  namespace: cloud-final
spec:
  interval: 30s
  timeout: 5m
  releaseName: cloud-app
  postRenderStrategy: combined
  chart:
    spec:
      chart: ./final-devops-project/helm
      reconcileStrategy: Revision
      sourceRef:
        kind: GitRepository
        name: cloud-source
        namespace: flux-system
  install:
    remediation: {retries: 3}
  upgrade:
    remediation: {retries: 3}
  driftDetection:
    mode: enabled
  values:
    image:
      repository: ghcr.io/reaperxd67/devops-homework
      tag: fc117d495fbe37568d8a72f06838d61e8946af1a
    appVersion: "1.0.0-cloud"
    existingSecret: app-secret
    ingress:
      enabled: true
      className: traefik
      host: ""
    autoscaling:
      enabled: true
      minReplicas: 2
      maxReplicas: 4
  postRenderers:
    - kustomize:
        images:
          - name: ghcr.io/reaperxd67/devops-homework
            newName: ghcr.io/reaperxd67/devops-homework
            digest: ${image_digest}
APPLICATION
kubectl apply -f /opt/scaler-cloud/application.yaml

cat > /opt/scaler-cloud/monitoring.yaml <<'MONITORING'
apiVersion: v1
kind: ServiceAccount
metadata: {name: prometheus, namespace: cloud-final}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata: {name: prometheus-discovery, namespace: cloud-final}
rules:
  - apiGroups: [""]
    resources: [pods]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata: {name: prometheus-discovery, namespace: cloud-final}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: Role, name: prometheus-discovery}
subjects:
  - {kind: ServiceAccount, name: prometheus, namespace: cloud-final}
---
apiVersion: v1
kind: ConfigMap
metadata: {name: prometheus-config, namespace: cloud-final}
data:
  prometheus.yml: |
    global: {scrape_interval: 5s, evaluation_interval: 5s}
    rule_files: [/etc/prometheus/alerts.yml]
    scrape_configs:
      - job_name: devops-app
        kubernetes_sd_configs:
          - role: pod
            namespaces: {names: [cloud-final]}
        relabel_configs:
          - source_labels: [__meta_kubernetes_pod_label_app_kubernetes_io_instance]
            regex: cloud-app
            action: keep
          - source_labels: [__meta_kubernetes_pod_container_name]
            regex: app
            action: keep
          - source_labels: [__meta_kubernetes_pod_container_port_name]
            regex: http
            action: keep
          - source_labels: [__meta_kubernetes_pod_phase]
            regex: Running
            action: keep
          - source_labels: [__meta_kubernetes_pod_name]
            target_label: pod
  alerts.yml: |
    groups:
      - name: application
        rules:
          - alert: ApplicationDown
            expr: sum(up{job="devops-app"}) == 0 or absent(up{job="devops-app"})
            for: 10s
            labels: {severity: critical}
            annotations: {summary: No final application target is reachable}
          - alert: HighApplicationMemory
            expr: process_resident_memory_bytes{job="devops-app"} > 100 * 1024 * 1024
            for: 1m
            labels: {severity: warning}
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: prometheus, namespace: cloud-final}
spec:
  replicas: 1
  selector: {matchLabels: {app: prometheus}}
  template:
    metadata: {labels: {app: prometheus}}
    spec:
      serviceAccountName: prometheus
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        fsGroup: 65534
        seccompProfile: {type: RuntimeDefault}
      containers:
        - name: prometheus
          image: prom/prometheus:v3.5.0
          args: ["--config.file=/etc/prometheus/prometheus.yml", "--storage.tsdb.path=/prometheus", "--storage.tsdb.retention.time=1h"]
          ports: [{name: http, containerPort: 9090}]
          readinessProbe: {httpGet: {path: /-/ready, port: http}}
          livenessProbe: {httpGet: {path: /-/healthy, port: http}}
          resources:
            requests: {cpu: 50m, memory: 128Mi}
            limits: {cpu: 300m, memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: {drop: [ALL]}
          volumeMounts:
            - {name: config, mountPath: /etc/prometheus, readOnly: true}
            - {name: data, mountPath: /prometheus}
      volumes:
        - name: config
          configMap: {name: prometheus-config}
        - name: data
          emptyDir: {sizeLimit: 256Mi}
---
apiVersion: v1
kind: Service
metadata: {name: prometheus, namespace: cloud-final}
spec:
  selector: {app: prometheus}
  ports: [{name: http, port: 9090, targetPort: http}]
MONITORING
kubectl apply -f /opt/scaler-cloud/monitoring.yaml
flux reconcile source git cloud-source -n flux-system --timeout=5m
flux reconcile helmrelease cloud-app -n cloud-final --timeout=8m
kubectl -n cloud-final rollout status deployment/cloud-app --timeout=180s
kubectl -n cloud-final rollout status deployment/prometheus --timeout=180s
kubectl -n kube-system rollout status deployment/traefik --timeout=180s
kubectl -n kube-system rollout status deployment/metrics-server --timeout=180s
curl --fail --retry 12 --retry-delay 5 --retry-all-errors http://127.0.0.1/healthz
kubectl -n cloud-final get deployment,service,ingress,hpa
printf 'BOOTSTRAP_COMPLETE\n'
